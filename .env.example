# Reference only — do NOT ship real values in a .env bundled with the app.
# In production, read these from the OS keychain (same mechanism as your
# provider API keys), pulled only inside the Electron main process.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Project Settings -> API -> service_role (secret)

# Never use SUPABASE_ANON_KEY for this sync engine — anon respects RLS,
# and RLS is intentionally locked down to default-deny (see 0002_rls.sql).
